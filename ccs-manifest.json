{
  "manifest_version": 1,
  "description": "Public base payload: curated Claude Code skills/commands/agents. Works standalone with ccs, or as the base layer under a private overlay.",
  "territories": {
    "dotclaude": {
      "root_var": "CLAUDE_DIR",
      "repo_dir": "dotclaude"
    },
    "userclaude": {
      "root_var": "USER_CLAUDE",
      "repo_dir": "userclaude"
    }
  },
  "entries": [
    {
      "repo": "dotclaude/CLAUDE.md",
      "territory": "dotclaude",
      "target": "CLAUDE.md",
      "strategy": "seed-if-absent"
    },
    {
      "repo": "dotclaude/skills",
      "territory": "dotclaude",
      "target": "skills",
      "strategy": "copy"
    },
    {
      "repo": "dotclaude/commands",
      "territory": "dotclaude",
      "target": "commands",
      "strategy": "copy"
    },
    {
      "repo": "dotclaude/agents",
      "territory": "dotclaude",
      "target": "agents",
      "strategy": "copy"
    },
    {
      "repo": "dotclaude/hooks",
      "territory": "dotclaude",
      "target": "hooks",
      "strategy": "copy"
    },
    {
      "repo": "dotclaude/scripts",
      "territory": "dotclaude",
      "target": "scripts",
      "strategy": "copy"
    },
    {
      "repo": "dotclaude/plugins-settings/session-logger.json",
      "territory": "dotclaude",
      "target": "plugins/settings/session-logger.json",
      "strategy": "seed-if-absent"
    },
    {
      "repo": "userclaude/claude-config/environment.md",
      "territory": "userclaude",
      "target": "claude-config/environment.md",
      "strategy": "seed-if-absent"
    },
    {
      "repo": "userclaude/claude-config/projects.md",
      "territory": "userclaude",
      "target": "claude-config/projects.md",
      "strategy": "seed-if-absent"
    },
    {
      "repo": "userclaude/claude-config/task-rules.md",
      "territory": "userclaude",
      "target": "claude-config/task-rules.md",
      "strategy": "seed-if-absent"
    }
  ],
  "collect_exclude": [
    "**/__pycache__/**",
    "**/*.pyc"
  ],
  "deny": []
}
